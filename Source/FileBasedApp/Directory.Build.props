<?xml version="1.0" encoding="utf-8"?><Project>
  <PropertyGroup>
     <VersionPrefix>1.2.0</VersionPrefix>      
      <PackageReleaseNotes>
          - Added LocalPathExtensions helpers to expand a leading ~ to the user profile directory.
          - Added GetSegments and Traverse to enumerate path segments in root-first or leaf-first order.
          - Updated Spectre.Console.Cli and TestableIO.System.IO.Abstractions dependencies.
      </PackageReleaseNotes>
  </PropertyGroup>
</Project>
