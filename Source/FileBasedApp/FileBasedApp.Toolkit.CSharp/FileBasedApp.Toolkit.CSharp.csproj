<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <LangVersion>latest</LangVersion>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <IsPackable>true</IsPackable>
        <Title>Roslyn helpers for FileBasedApps</Title>
        <Description>Roslyn-based helpers for detecting and working with file-based .NET apps.</Description>
        <PackageReadmeFile>README.md</PackageReadmeFile>
        <GenerateDocumentationFile>true</GenerateDocumentationFile>
        <RepositoryUrl>https://github.com/jeppevammenkristensen/FileBasedApp.Toolkit/tree/main/Source/FileBasedApp/FileBasedApp.Toolkit.CSharp</RepositoryUrl>
        <PackageLicenseExpression>MIT</PackageLicenseExpression>
        <PackageIcon>floppy-disc.png</PackageIcon>
        <PackageReleaseNotes>
- Replaced regex-based PackageVersion parsing with NuGet.Versioning (NuGetVersion) for robust version handling
- Added NugetVersion and RequiredNugetVersion properties to PackageVersion for direct NuGet version access
- Added WithNugetVersion and WithValue fluent methods to PackageVersion for immutable-style version updates
- Made PackageVersion.Value setter private (breaking: use WithValue instead)
- Made PackageInfo.PackageInfo setter private (breaking)
- Moved PackageVersion and PackageVersionType to separate files
- Improved MSBuild locator initialization with explicit validation and descriptive error messages
- Added buildTransitive props to enable reflection-based JSON serialization for .NET 10+ compatibility (required by MSBuild workspaces)
- Added NuGet.Versioning package dependency
- Fixed PackageDirectiveWrapper.Update() failing when updating multiple package directives sequentially on the same syntax tree
        </PackageReleaseNotes>       
        
    </PropertyGroup>

    <ItemGroup>
        <InternalsVisibleTo Include="FileBasedApp.Toolkit.CSharp.Tests" />
    </ItemGroup>

    <ItemGroup>
        <!-- Package 'Microsoft.IO.Redist' 6.0.0 has a known high severity vulnerability -->
        <NuGetAuditSuppress Include="https://github.com/advisories/GHSA-hq7w-xv5x-g34j" />
        <!-- Package 'System.Text.Json' 8.0.0 has a known high severity vulnerability -->
        <NuGetAuditSuppress Include="https://github.com/advisories/GHSA-8g4q-xg66-9fp4" />
        <!-- Package 'System.Text.Json' 8.0.0 has a known high severity vulnerability -->
        <NuGetAuditSuppress Include="https://github.com/advisories/GHSA-hh2w-p6rv-4g7w" />
        <!-- Package 'Microsoft.Build.Tasks.Core' 17.7.2 has a known high severity vulnerability -->
        <NuGetAuditSuppress Include="https://github.com/advisories/GHSA-h4j7-5rxr-p4wc" />
    </ItemGroup>

    <ItemGroup>
        <None Include="README.md" Pack="true" PackagePath="\" />
        <None Include="..\floppy-disc.png" Pack="true" PackagePath="\" />
        <None Include="buildTransitive\FileBasedApp.Toolkit.CSharp.props" Pack="true" PackagePath="buildTransitive\" />
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\FileBasedApp.Toolkit\FileBasedApp.Toolkit.csproj" />
    </ItemGroup>

    <ItemGroup>
        <PackageReference Include="Microsoft.CodeAnalysis.CSharp" Version="5.3.0" />
        <PackageReference Include="NuGet.Versioning" Version="7.3.0" />
        <PackageReference Include="Roslynator.CSharp" Version="4.15.0" />

        <PackageReference Include="Microsoft.Build" Version="18.0.2" ExcludeAssets="runtime" />
        <PackageReference Include="Microsoft.Build.Locator" Version="1.7.8" />        
        <PackageReference Include="Microsoft.CodeAnalysis.CSharp.Workspaces" Version="5.3.0" />
        <PackageReference Include="Microsoft.CodeAnalysis.Workspaces.Common" Version="5.3.0" />
        <PackageReference Include="Microsoft.CodeAnalysis.Workspaces.MSBuild" Version="5.3.0" PrivateAssets="analyzers;build" />

    </ItemGroup>

</Project>
