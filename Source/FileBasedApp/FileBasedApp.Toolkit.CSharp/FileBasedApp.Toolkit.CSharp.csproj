<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <LangVersion>latest</LangVersion>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <IsPackable>true</IsPackable>
        <Title>Roslyn helpers for FileBasedApps</Title>
        <Description>Roslyn-based helpers for detecting and working with file-based .NET apps.</Description>
        <PackageReadmeFile>README.md</PackageReadmeFile>
        <GenerateDocumentationFile>true</GenerateDocumentationFile>
        <RepositoryUrl>https://github.com/jeppevammenkristensen/FileBasedApp.Toolkit/tree/main/Source/FileBasedApp/FileBasedApp.Toolkit.CSharp</RepositoryUrl>
        <PackageLicenseExpression>MIT</PackageLicenseExpression>
        <PackageReleaseNotes>
- Renamed all Csharp prefixes to CSharp (CsharpProjectAnalysis → CSharpProjectAnalysis, CsharpRegex → CSharpRegex, etc.)
- Extracted BaseAnalysis base class from CSharpProjectAnalysis for shared MSBuild workspace logic
- Added CSharpSolutionAnalysis for loading and analyzing full .sln solutions
- Added shebang directive (#!) support to FileBasedAppEvaluator
- Added string-based IsFileBasedApp overload for evaluating C# text without file I/O
- Added FileBasedDirectiveType enum for classifying directives (Package, Property, Sdk, Project)
- Added FileBasedAppWrapper for parsing and inspecting file-based app directives
- Added IgnoredDirectiveWrapper for extracting typed directive info from Roslyn trivia
- Added PackageDirectiveWrapper with Update method for modifying package directives in-place
- Added PackageInfo record for parsing package name and version from directives
        </PackageReleaseNotes>
        <VersionPrefix>0.18.0</VersionPrefix>
        <VersionSuffix>alpha-11</VersionSuffix>                
    </PropertyGroup>

    <ItemGroup>
        <InternalsVisibleTo Include="FileBasedApp.Toolkit.CSharp.Tests" />
    </ItemGroup>

    <ItemGroup>
        <!-- Package 'Microsoft.IO.Redist' 6.0.0 has a known high severity vulnerability -->
        <NuGetAuditSuppress Include="https://github.com/advisories/GHSA-hq7w-xv5x-g34j" />
        <!-- Package 'System.Text.Json' 8.0.0 has a known high severity vulnerability -->
        <NuGetAuditSuppress Include="https://github.com/advisories/GHSA-8g4q-xg66-9fp4" />
        <!-- Package 'System.Text.Json' 8.0.0 has a known high severity vulnerability -->
        <NuGetAuditSuppress Include="https://github.com/advisories/GHSA-hh2w-p6rv-4g7w" />
        <!-- Package 'Microsoft.Build.Tasks.Core' 17.7.2 has a known high severity vulnerability -->
        <NuGetAuditSuppress Include="https://github.com/advisories/GHSA-h4j7-5rxr-p4wc" />
    </ItemGroup>

    <ItemGroup>
        <None Include="README.md" Pack="true" PackagePath="\" />
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\FileBasedApp.Toolkit\FileBasedApp.Toolkit.csproj" />
    </ItemGroup>

    <ItemGroup>
        <PackageReference Include="Microsoft.CodeAnalysis.CSharp" Version="5.3.0" />
        <PackageReference Include="Roslynator.CSharp" Version="4.15.0" />

        <PackageReference Include="Microsoft.Build" Version="18.0.2" ExcludeAssets="runtime" />
        <PackageReference Include="Microsoft.Build.Locator" Version="1.7.8" />        
        <PackageReference Include="Microsoft.CodeAnalysis.CSharp.Workspaces" Version="5.3.0" />
        <PackageReference Include="Microsoft.CodeAnalysis.Workspaces.Common" Version="5.3.0" />
        <PackageReference Include="Microsoft.CodeAnalysis.Workspaces.MSBuild" Version="5.3.0" />

    </ItemGroup>

</Project>
