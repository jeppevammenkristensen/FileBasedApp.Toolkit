<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>        
        <LangVersion>14</LangVersion>
        <IsPackable>true</IsPackable>
        <Title>Spectre helpers for FileBasedApps</Title>
        <Description>Spectre.Console output factories and Spectre.Console.Cli settings helpers for file-based apps.</Description>
        <PackageReadmeFile>README.md</PackageReadmeFile>
        <GenerateDocumentationFile>true</GenerateDocumentationFile>
        <RepositoryUrl>https://github.com/jeppevammenkristensen/FileBasedApp.Toolkit</RepositoryUrl>
        <PackageLicenseExpression>MIT</PackageLicenseExpression>
        <PackageIcon>floppy-disc.png</PackageIcon>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
    </PropertyGroup>

    <ItemGroup>
        <ProjectReference Include="../FileBasedApp.Toolkit/FileBasedApp.Toolkit.csproj"/>
        <PackageReference Include="Spectre.Console" Version="0.57.2"/>
        <PackageReference Include="Spectre.Console.Cli" Version="0.57.2"/>
        <PackageReference Include="TruePath" Version="2.0.0"/>
        <InternalsVisibleTo Include="FileBasedApp.Toolkit.Spectre.Tests"/>
        <None Include="README.md" Pack="true" PackagePath="/"/>
        <None Include="../floppy-disc.png" Pack="true" PackagePath="/"/>
    </ItemGroup>
</Project>
