<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>    
    <IsPackable>true</IsPackable>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <Title>Opiniated helpers for FileBasedApps</Title>
    <Description>Opiniated helpers for a FileBaseApp. Based on TruePath, SimpleExec and Spectre.Console.Cli</Description>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <TargetFrameworks>net10.0;net8.0</TargetFrameworks>
    <RepositoryUrl>https://github.com/jeppevammenkristensen/FileBasedApp.Toolkit/tree/main/Source/FileBasedApp/FileBasedApp.Toolkit</RepositoryUrl>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageIcon>floppy-disc.png</PackageIcon>    
    <PackageReleaseNotes>Added WithAcceptedErrorCodes and HandlesAllErrorCodes for SimpleExec exit-code handling; added RunWithExitCode, RunWithExitCodeAsync, ReadEnhancedAsync, SimpleExecRunResult, and SimpleExecReadResult; fixed strict AddSecrets validation.</PackageReleaseNotes>
    <LangVersion>14</LangVersion>    
  </PropertyGroup>
  
  <PropertyGroup Condition="'$(Configuration)' == 'Debug'">
    <!-- Ensure PDBs are produced and carried along for local debug deploy/publish -->
    <DebugType>full</DebugType>
    <DebugSymbols>true</DebugSymbols>        
  </PropertyGroup>

  <ItemGroup>
    <None Include="README.md" Pack="true" PackagePath="\" />
    <None Include="..\floppy-disc.png" Pack="true" PackagePath="\" />
  </ItemGroup>
  
  <ItemGroup>
    <PackageReference Include="JetBrains.Annotations" Version="2026.2.0" />
    <PackageReference Include="Microsoft.CodeAnalysis.Analyzers" Version="5.9.0">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="NuGet.Versioning" Version="7.9.0" />
    <PackageReference Include="SimpleExec" Version="13.0.0" />    
    <PackageReference Include="Spectre.Console.Cli" Version="0.55.0" />
    <PackageReference Include="TestableIO.System.IO.Abstractions.Wrappers" Version="22.2.0" />
    <PackageReference Include="TruePath.TestableIO.System.IO" Version="1.0.1" />
    <PackageReference Include="TruePath" Version="1.12.0" />
    <PackageReference Include="Vogen" Version="8.0.7" />
    
  </ItemGroup> 
 
  <ItemGroup>
    <InternalsVisibleTo Include="FileBasedApp.Toolkit.Tests" />
  </ItemGroup> 
 
  

</Project>
