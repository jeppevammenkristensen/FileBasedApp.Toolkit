<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>    
    <IsPackable>true</IsPackable>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <Title>Opiniated helpers for FileBasedApps</Title>
    <Description>Opiniated helpers for a FileBaseApp. Based on TruePath, SimpleExec and Spectre.Console.Cli</Description>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <TargetFrameworks>net10.0;net8.0</TargetFrameworks>
    <RepositoryUrl>https://github.com/jeppevammenkristensen/FileBasedApp.Toolkit/tree/main/Source/FileBasedApp/FileBasedApp.Toolkit</RepositoryUrl>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageIcon>floppy-disc.png</PackageIcon>   
    <IsPackable>true</IsPackable>
    <PackageReleaseNotes>     
    </PackageReleaseNotes>
    <LangVersion>14</LangVersion>    
  </PropertyGroup>
  
  <PropertyGroup Condition="'$(Configuration)' == 'Debug'">
    <!-- Ensure PDBs are produced and carried along for local debug deploy/publish -->
    <DebugType>full</DebugType>
    <DebugSymbols>true</DebugSymbols>        
  </PropertyGroup>

  <ItemGroup>
    <None Include="README.md" Pack="true" PackagePath="\" />
    <None Include="..\floppy-disc.png" Pack="true" PackagePath="\" />
  </ItemGroup>
  
  <ItemGroup>    
    <PackageReference Include="Microsoft.CodeAnalysis.Analyzers">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="NuGet.Versioning" />
    <PackageReference Include="SimpleExec" />
    <PackageReference Include="Spectre.Console.Cli" />
    <PackageReference Include="Spectre.Console" />
    <PackageReference Include="TestableIO.System.IO.Abstractions.Wrappers" />
    <PackageReference Include="TruePath.TestableIO.System.IO" />
    <PackageReference Include="TruePath" />
    <PackageReference Include="Vogen" />
    
  </ItemGroup> 
 
  <ItemGroup>
    <InternalsVisibleTo Include="FileBasedApp.Toolkit.Tests" />
  </ItemGroup> 
 
  

</Project>