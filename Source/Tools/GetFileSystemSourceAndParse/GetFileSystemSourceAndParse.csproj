      <PackageReference Include="Roslynator.CSharp.Workspaces" Version="5.0.0" />
      <PackageReference Include="Testably.Abstractions.FileSystem.Interface" Version="10.3.0" />
      <PackageReference Include="TextCopy" Version="6.2.1" />
